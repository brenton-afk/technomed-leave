# ─── REDIS (UPSTASH) ────────────────────────────────────
# The only persistence layer: leave applications, staff PINs, sessions,
# and Xero OAuth tokens.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ─── XERO ───────────────────────────────────────────────
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here
XERO_REDIRECT_URI=https://leave.technomed.com.au/api/xero/callback
# Optional: only used as a fallback before the first OAuth connect stores the
# tenant ID in Redis.
XERO_TENANT_ID=your_xero_tenant_id_here

# ─── GOOGLE CALENDAR ─────────────────────────────────────
# Paste the entire JSON content of your service account key file as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_CALENDAR_ID=bookings@technomed.com.au

# ─── EMAIL (RESEND) ──────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
# Must be a verified Resend sender; defaults to the Resend onboarding address.
EMAIL_FROM=TechnoMed Leave Portal <noreply@technomed.com.au>
EMAIL_TO_1=Erin@technomed.com.au
EMAIL_TO_2=Brenton@technomed.com.au
EMAIL_TO_3=Bookings@technomed.com.au

# ─── APP ─────────────────────────────────────────────────
VITE_APP_URL=https://leave.technomed.com.au

# ─── USAGE SCANNING ──────────────────────────────────────
# Dropbox app token with files.content.write on the ALL SURGEON USAGE tree.
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token_here
# Optional: override the vision model without a redeploy.
USAGE_VISION_MODEL=claude-opus-5

# ─── TIMESHEET REMINDERS (TWILIO) ────────────────────────
# Staff mobile numbers live in src/staffConfig.js (mobileNumber).
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+61400000000
# Set by Vercel for cron auth; also verified by the reminder endpoint.
CRON_SECRET=a_long_random_string

# ─── MEETING AGENT ───────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
