{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/meetings/agent.js": {
      "includeFiles": "node_modules/@vercel/blob/**"
    },
    "api/usage/agent.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/timesheet/agent.js": {
      "maxDuration": 30
    },
    "api/cron/timesheet-reminder.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/timesheet-reminder",
      "schedule": "0 22 * * 5"
    },
    {
      "path": "/api/cron/timesheet-reminder",
      "schedule": "0 22 * * 6"
    }
  ]
}
