{
  "rewrites": [
    {
      "source": "/api/dropbox/:action",
      "destination": "/api/guides?dropbox=:action"
    },
    {
      "source": "/api/treasury/xero-callback",
      "destination": "/api/treasury?action=xero-callback"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/meetings/agent.js": {
      "includeFiles": "node_modules/@vercel/blob/**",
      "maxDuration": 120
    },
    "api/chat.js": {
      "includeFiles": "node_modules/@vercel/blob/**"
    },
    "api/calendar/today.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/usage/agent.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/timesheet/agent.js": {
      "maxDuration": 30
    },
    "api/cron/timesheet-reminder.js": {
      "maxDuration": 60
    },
    "api/guides.js": {
      "includeFiles": "theatre-guides/**",
      "maxDuration": 30,
      "memory": 1024
    },
    "api/treasury.js": {
      "maxDuration": 60
    },
    "api/xero/info.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/timesheet-reminder?job=evening",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/timesheet-reminder?job=morning",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/timesheet-reminder?job=nightly",
      "schedule": "27 15 * * *"
    },
    {
      "path": "/api/treasury?action=cron",
      "schedule": "40 19 * * *"
    },
    {
      "path": "/api/treasury?action=cron",
      "schedule": "40 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
